<!-- Contenedor principal tipo tarjeta -->
<div class="max-w-3xl mx-auto mt-10 p-8 bg-white shadow-2xl rounded-2xl border border-gray-100">
    
    <!-- Título principal -->
    <h1 class="text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-red-500 to-orange-500 mb-2">
        {{title}}
    </h1>
    
    <!-- Subtítulo -->
    <p class="text-lg text-gray-600 font-medium mb-6">
        Welcome to <span class="text-red-500 font-semibold">{{title}}</span>
    </p>
    
    <!-- Contador estilo 'badge' o píldora -->
    <div class="inline-block bg-red-100 text-red-700 font-bold px-4 py-2 rounded-full mb-8 shadow-sm">
        Counter: {{counter}}
    </div>

    <!-- Cuadrícula para los pollitos -->
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-4 mb-8">
        {{#each numbers}}
        <div class="bg-yellow-50 rounded-xl p-4 text-center border border-yellow-200 shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 cursor-default">
            <p class="text-yellow-700 font-semibold text-lg">Te mando un 🐥</p>
        </div>
        {{/each}}
    </div>

    <!-- Contenedor de la imagen con bordes redondeados y efecto hover -->
    <div class="overflow-hidden rounded-xl shadow-lg border border-gray-200">
        <!-- Aquí está vinculada tu imagen webp -->
        <img 
            src="/images/imagen1.webp" 
            alt="Mi imagen webp" 
            class="w-full h-auto object-cover hover:scale-105 transition-transform duration-500"
        >
    </div>

</div>