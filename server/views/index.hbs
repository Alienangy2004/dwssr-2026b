<div class="p-6 max-w-2xl mx-auto font-sans text-gray-900">
    
    <h1 class="text-3xl font-mono font-bold text-green-900 mb-4">
        {{title}}
    </h1>
    
    <!-- Texto de bienvenida -->
    <p class="mb-6 text-gray-700 font-medium">
        Welcome to {{title}}
    </p>
    
    <p class="inline-block bg-teal-900 text-gray-100 px-5 py-2 rounded-md mb-6 font-semibold shadow-md cursor-pointer hover:bg-teal-950 transition-colors">
        Counter: {{counter}}
    </p>

    <!-- Lista de pollitos ke kreisi-->
    <div class="mb-6">
        {{#each numbers}}
        <p class="mb-2 text-gray-800 font-medium">Te mando un 🐥</p>
        {{/each}}
    </div>

    <img 
        src="/images/imagen1.webp" 
        alt="Mi imagen webp" 
        class="w-full max-w-md rounded-lg border-4 border-gray-950 shadow-lg hover:shadow-xl transition-shadow"
    >
</div>